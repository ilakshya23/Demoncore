# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to browser

# Resend — resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=you@demoncoremc.fun

# Shared secret the Velocity + gamemode plugins send in the x-plugin-key header
PLUGIN_API_KEY=change-me-to-a-long-random-string

# Admin panel (Phase 3) — Supabase Auth handles login; no extra secret needed here
