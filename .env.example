# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to browser

# Resend — resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=you@demoncoremc.fun

# Shared secret the Velocity + gamemode plugins send in the x-plugin-key header
PLUGIN_API_KEY=change-me-to-a-long-random-string

# Admin panel login — the only credentials that unlock /admin.
# Quote the value if it contains a #, space, or other special character —
# otherwise dotenv treats everything after # as a comment and silently
# truncates the password.
ADMIN_ID=admin
ADMIN_PASSWORD="change-me"

# Razorpay — dashboard.razorpay.com/app/keys (free to sign up; Razorpay just
# takes its standard per-transaction fee, no monthly cost). Leave unset and
# checkout falls back to "submit order, we'll follow up" with no payment step.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
